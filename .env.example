SECRET_KEY=tu_clave_aqui
FLASK_ENV=development
APP_ENV=development
ENABLE_DEV_QA_PANEL=false

# Limites de seguridad locales. En development/testing se mantiene memoria.
# Para produccion se podra usar Redis cuando se incorpore la dependencia operativa.
MAX_CONTENT_LENGTH_BYTES=1048576
MAX_FORM_MEMORY_SIZE_BYTES=1048576
RATELIMIT_STORAGE_URI=memory://

# Clave publica de navegador para Google Maps JavaScript API.
# Debe restringirse por origen autorizado, API permitida y cuota de uso.
GOOGLE_MAPS_API_KEY=tu_clave_real

# Storage de imagenes profesionales.
# En development/testing usar local. En staging/production se recomienda cloudinary.
MEDIA_STORAGE_PROVIDER=local
LOCAL_MEDIA_UPLOAD_ROOT=app/static/uploads/professional_media
LOCAL_MEDIA_PUBLIC_BASE_URL=/static/uploads/professional_media
MEDIA_AUTO_PUBLISH=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=trax/professional_media
